# Default reads the existing Firebase catalog. No automatic file fallback.
VITE_CATALOG_SOURCE=firebase
VITE_CATEGORIES_PATH=Categories
VITE_SERVICES_PATH=Services
VITE_BARBERS_PATH=Barbers
# Use true ONLY with firebase emulators:start --project demo-barberqueue
VITE_USE_EMULATORS=false
# Offline inspection only: json OR excel (booking/admin writes disabled)
