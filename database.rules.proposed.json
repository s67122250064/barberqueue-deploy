{
 "rules": {
  ".read": false,
  ".write": false,
  "Categories": {".read": true, ".write": false},
  "Services": {".read": true, ".write": false},
  "Barbers": {".read": true, ".write": false},
  "barberQueueV2": {
   "settings": {".read": "auth != null", ".write": false},
   "roles": {"$uid": {".read":"auth != null && auth.uid === $uid", ".write":false}},
   "users": {"$uid": {
    ".read":"auth != null && (auth.uid === $uid || root.child('barberQueueV2/roles').child(auth.uid).child('role').val() === 'admin')",
    ".write":"auth != null && auth.uid === $uid && newData.exists()",
    ".validate":"newData.hasChildren(['name','email','phone'])",
    "name":{".validate":"newData.isString() && newData.val().length > 0 && newData.val().length <= 100"},
    "email":{".validate":"newData.isString() && newData.val() === auth.token.email"},
    "phone":{".validate":"newData.isString() && (newData.val() === '' || newData.val().matches(/^0[0-9]{8,9}$/))"},
    "$other":{".validate":false}
   }},
   "bookingState":{".read":false,".write":false}
  }
 }
}
